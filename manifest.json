{
  "manifest_version": 3,
  "name": "FunPay Helper",
  "version": "0.9.31",
  "description": "Шаблоны, перевод, подсветка своих лотов, номера заказов и напоминания для FunPay.",
  "permissions": [
    "storage",
    "alarms",
    "offscreen",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://funpay.com/*",
    "https://raw.githubusercontent.com/*",
    "https://translate.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://funpay.com/*"
      ],
      "js": [
        "defaults.js",
        "content.js",
        "header.js",
        "listing-translator.js",
        "own-lots.js"
      ],
      "css": [
        "content.css",
        "listing-translator.css",
        "own-lots.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "FunPay Helper"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "app.html"
      ],
      "matches": [
        "https://funpay.com/*"
      ]
    }
  ]
}
