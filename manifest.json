{
  "manifest_version": 3,
  "name": "FunPay Helper",
  "version": "0.3.0",
  "description": "Помощник для продавцов FunPay: окно FP Helper, шаблоны сообщений, лоты, статистика продаж.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://funpay.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://funpay.com/*"],
      "js": ["defaults.js", "content.js", "header.js", "page.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "FunPay Helper"
  }
}
