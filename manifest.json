{
  "manifest_version": 3,
  "name": "FunPay Helper",
  "version": "0.7.0",
  "description": "Быстрые ответы в чатах FunPay: сохраняйте шаблоны и вставляйте их в сообщения.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://funpay.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://funpay.com/*"
      ],
      "js": [
        "defaults.js",
        "content.js",
        "header.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "FunPay Helper"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "app.html"
      ],
      "matches": [
        "https://funpay.com/*"
      ]
    }
  ]
}
