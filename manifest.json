{
  "manifest_version": 3,
  "name": "FunPay Helper",
  "version": "0.1.0",
  "description": "Шаблоны сообщений для чатов FunPay.",
  "permissions": ["storage"],
  "host_permissions": ["https://funpay.com/*"],
  "content_scripts": [
    {
      "matches": ["https://funpay.com/*"],
      "js": ["defaults.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FunPay Helper"
  }
}
